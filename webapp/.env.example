# WalletConnect project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Custom RPC endpoints (optional — falls back to wagmi's default public RPC)
VITE_BASE_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Live interactive Robinhood EventMarketV2. Historical FAIR/TOXIC evidence remains
# pinned separately to 0x4F946Cca7f8da191168f76Fe12fbD6cfa1CAA26e.
# Missing, malformed, and zero addresses deliberately render an unconfigured page
# unless the frontend falls back to the pinned verified live address.
VITE_ROBINHOOD_ODDSHIFT_MARKET_ADDRESS=0x5c70D71Bc29b883c0F10DEC5E8Aacd3F17B99a61

# Uniswap integrator fee bps used for client-side output adjustment.
# Must match UNISWAP_FEE_BPS in the bot. When > 0, the quote target is grossed
# up so the user receives exactly the displayed USDC amount after the fee.
VITE_UNISWAP_FEE_BPS=
